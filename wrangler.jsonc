{
  // Situs statis willoapparel.com. Semua file situs ada di folder public/.
  "name": "willoapparel",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  // Domain utama & www lewat Worker ini (DNS A @ dan www 192.0.2.1, proxied).
  // Ditulis di sini supaya setiap deploy otomatis memasang ulang route-nya.
  "routes": [
    { "pattern": "willoapparel.com/*", "zone_name": "willoapparel.com" },
    { "pattern": "*.willoapparel.com/*", "zone_name": "willoapparel.com" }
  ],
  "workers_dev": true,
  // Notifikasi HP Dunia Kotak (Huda 11 Nov 2026): cek pengingat yang jatuh tempo tiap 10 menit (lihat scheduled() di worker.js).
  "triggers": { "crons": ["*/10 * * * *"] },
  // Penghitung pengunjung asli untuk pop up halaman produk (lihat class Pengunjung di worker.js).
  "durable_objects": {
    "bindings": [
      { "name": "PENGUNJUNG", "class_name": "Pengunjung" },
      // Daftar warga Dunia Kotak (lihat class Warga di worker.js).
      { "name": "WARGA", "class_name": "Warga" },
      // Ruang online game mabar per dusun (lihat class Ruang di worker.js).
      { "name": "RUANG", "class_name": "Ruang" },
      // Dashboard owner Lumbung: penjualan per toko (lihat class Toko di worker.js).
      { "name": "TOKO", "class_name": "Toko" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pengunjung"] },
    { "tag": "v2", "new_sqlite_classes": ["Warga"] },
    { "tag": "v3", "new_sqlite_classes": ["Ruang"] },
    { "tag": "v4", "new_sqlite_classes": ["Toko"] }
  ],
  // Client ID Google (publik, bukan rahasia) untuk tombol "Lanjut dengan Google" di /duniakotak/.
  // Kosong = tombol belum aktif. Isi dengan Client ID dari Google Cloud Console.
  // RS_TOKO = ID toko kasir Lumbung Willo (bukan rahasia; kuncinya tetap di link owner) untuk masuk /reseller/admin/ dengan link owner.
  "vars": { "GOOGLE_CLIENT_ID": "1082997408742-9515voc2uflmub1q0bfr9o0htuvof5dn.apps.googleusercontent.com", "TG_CHAT_ID": "5667928446", "RS_TOKO": "r653w141jc0vmpfy7elj" },
  // Workers AI (kuota gratis harian) untuk gambar Flux di /alat/gambar/ (lihat apiGambar di worker.js).
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Sajikan /halaman.html apa adanya (tanpa redirect), sesuai URL di sitemap.
    "html_handling": "none",
    // Alamat yang tidak ada → public/404.html (bukan layar putih kosong).
    "not_found_handling": "404-page",
    // Jalankan worker.js dulu untuk halaman, API, dan link pendek (www dialihkan, kunjungan dicatat).
    // File statis berat (gambar, model 3D, skrip game, video) langsung dari aset TANPA memanggil worker:
    // permintaan aset statis gratis & tak terbatas, sedangkan permintaan worker dibatasi 100.000/hari di paket gratis.
    // (Huda 18 Nov 2026, rencana jutaan pengunjung.) Header cache folder three/ dipindah ke public/_headers.
    "run_worker_first": [
      "/*",
      "!/foto-hasil/*",
      "!/gambar-artikel/*",
      "!/mockup/*",
      "!/video/*",
      "!/_three/*",
      "!/duniakotak/three/*",
      "!/duniakotak/js/*",
      "!/duniakotak/ikon/*",
      "!/duniakotak/mabar/js/*",
      "!/duniakotak/mabar/aset/*",
      "!/duniakotak/mabar/*.js",
      "!/duniakotak/mabar/*.css",
      "!/duniakotak/belajar/aset/*",
      "!/duniakotak/pulau/*.jpg",
      "!/duniakotak/pulau/*.json",
      "!/style.css",
      "!/home.css", "!/halaman.css",
      "!/script.js",
      "!/wa-tag.js",
      "!/logo-willo.png",
      "!/logo-willo-putih.png",
      "!/workshop-sablon.jpg"
    ]
  }
}
