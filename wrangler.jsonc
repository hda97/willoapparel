{
  // Situs utama produksi. Jangan deploy top-level config untuk pengujian staging.
  "name": "willoapparel",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "routes": [
    { "pattern": "willoapparel.com/*", "zone_name": "willoapparel.com" },
    { "pattern": "*.willoapparel.com/*", "zone_name": "willoapparel.com" }
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "PENGUNJUNG", "class_name": "Pengunjung" },
      { "name": "WARGA", "class_name": "Warga" },
      { "name": "RUANG", "class_name": "Ruang" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pengunjung"] },
    { "tag": "v2", "new_sqlite_classes": ["Warga"] },
    { "tag": "v3", "new_sqlite_classes": ["Ruang"] }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "1082997408742-9515voc2uflmub1q0bfr9o0htuvof5dn.apps.googleusercontent.com",
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      // Wrangler akan membuat Worker terpisah: willoapparel-staging.
      // Tidak ada custom route/domain produksi di environment ini.
      "name": "willoapparel-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "GOOGLE_CLIENT_ID": "1082997408742-9515voc2uflmub1q0bfr9o0htuvof5dn.apps.googleusercontent.com",
        "ENVIRONMENT": "staging"
      },
      // Binding DO didefinisikan ulang agar storage staging terisolasi
      // dari Worker produksi. Jangan tambahkan script_name produksi.
      "durable_objects": {
        "bindings": [
          { "name": "PENGUNJUNG", "class_name": "Pengunjung" },
          { "name": "WARGA", "class_name": "Warga" },
          { "name": "RUANG", "class_name": "Ruang" }
        ]
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "404-page",
        "run_worker_first": true
      }
    }
  }
}
