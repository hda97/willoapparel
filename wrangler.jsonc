{
  // Situs statis willoapparel.com. Semua file situs ada di folder public/.
  "name": "willoapparel",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  // Domain utama & www lewat Worker ini (DNS A @ dan www 192.0.2.1, proxied).
  // Ditulis di sini supaya setiap deploy otomatis memasang ulang route-nya.
  "routes": [
    { "pattern": "willoapparel.com/*", "zone_name": "willoapparel.com" },
    { "pattern": "*.willoapparel.com/*", "zone_name": "willoapparel.com" }
  ],
  "workers_dev": true,
  // Penghitung pengunjung asli untuk pop up halaman produk (lihat class Pengunjung di worker.js).
  "durable_objects": {
    "bindings": [{ "name": "PENGUNJUNG", "class_name": "Pengunjung" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pengunjung"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Sajikan /halaman.html apa adanya (tanpa redirect), sesuai URL di sitemap.
    "html_handling": "none",
    // Jalankan worker.js dulu supaya www bisa dialihkan.
    "run_worker_first": true
  }
}
